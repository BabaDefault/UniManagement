+    private void startWhenInstanceIsActive(
+            final ReactContext reactContext,
+            final HeadlessJsTaskContext headlessJsTaskContext,
+            final HeadlessJsTaskConfig taskConfig,
+            final int attempt) {
+        UiThreadUtil.runOnUiThread(() -> {
+            if (reactContext.hasActiveReactInstance()) {
+                this.taskId = headlessJsTaskContext.startTask(taskConfig);
+            } else if (attempt < START_TASK_MAX_ATTEMPTS) {
+                new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
+                        () -> startWhenInstanceIsActive(
