+    // PATCHED (patch-package): wait for the React instance to actually be active.
+    //
+    // onReactContextInitialized fires once the ReactContext object exists, but in
+    // bridgeless mode the JS instance is not live yet at that point. React Native's
+    // HeadlessJsTaskContext.startTask checks reactContext.hasActiveReactInstance()
+    // and, when false, drops the task with a soft exception reading
+    // "Cannot start headless task, CatalystInstance not available". The widget then
+    // never draws and shows an empty frame with no error anywhere.
+    //
+    // Polling the main looper until the instance is live fixes the race. Capped so a
+    // genuinely dead instance cannot leave this looping forever.
+    private static final int START_TASK_MAX_ATTEMPTS = 100;
+    private static final long START_TASK_RETRY_MS = 100;
