# Supabase project credentials.
#
# Dashboard -> Project Settings -> Data API  (URL)
#           -> Project Settings -> API Keys  (anon / publishable key)
#
# Only variables prefixed EXPO_PUBLIC_ are exposed to the app bundle. The anon
# key is meant to be public; row level security in supabase/schema.sql is what
# keeps the data private, so do not put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
